{
  "name": "open-browser",
  "version": "0.1.0",
  "description": "OpenBrowser — execution-first AI browser (like OpenClaw, OpenAI). AI controls the browser via extension.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "npm run build:extension && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:extension": "cd extension && npm run build",
    "start": "npm run build:extension && npm run build:electron && electron dist/electron/main.js",
    "dev": "concurrently \"npm run build:electron -- --watch\" \"electron dist/electron/main.js\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "electron",
    "browser",
    "ai",
    "automation",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "dotenv": "^16.6.1",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  }
}
