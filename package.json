{
  "name": "open-browser",
  "version": "0.1.0",
  "description": "OpenBrowser — execution-first AI browser (like OpenClaw, OpenAI). AI controls the browser via extension.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "npm run build:extension && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "build:extension": "cd extension && npm run build",
    "start": "npm run build:extension && npm run build:electron && electron dist/electron/main.js",
    "dev": "concurrently \"npm run build:electron -- --watch\" \"electron dist/electron/main.js\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint:fix": "eslint --fix",
    "spell": "cspell \"**/*.{js,jsx,ts,tsx,md,json}\" --no-progress",
    "security:secrets": "secretlint \"**/*\"",
    "security": "npm audit --audit-level=moderate",
    "prepare": "husky"
  },
  "keywords": [
    "electron",
    "browser",
    "ai",
    "automation",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mediusware/mw-husky-config": "^0.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "cspell": "^9.6.0",
    "electron": "^28.0.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "dotenv": "^16.6.1",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "cspell --config .cspell.json --no-must-find-files"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "cspell --config .cspell.json --no-must-find-files"
    ],
    "*.{json,css,md}": [
      "prettier --write",
      "cspell --config .cspell.json --no-must-find-files"
    ]
  }
}
