{
  "manifest_version": 2,
  "name": "OpenBrowser Agent",
  "version": "0.1.0",
  "description": "AI-controlled browser automation - perception and action execution",
  "permissions": [
    "activeTab",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["dist/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
