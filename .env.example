# OpenBrowser - AI Configuration
# Copy to .env and fill in your values

# Active AI provider: gemini | ollama | heuristic
# heuristic = no AI, uses built-in rule-based planner
PIXIS_AI_PROVIDER=heuristic

# Model name (used by the active provider)
# Gemini: gemini-2.0-flash, gemini-1.5-pro, etc.
# Ollama: llama3.2, mistral, phi3, etc.
PIXIS_AI_MODEL=gemini-2.0-flash

# Gemini API key (required if PIXIS_AI_PROVIDER=gemini)
# Get free key at https://aistudio.google.com/app/apikey
PIXIS_GEMINI_API_KEY=

# Ollama base URL (default if PIXIS_AI_PROVIDER=ollama)
# Run: ollama run llama3.2
PIXIS_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (future)
# PIXIS_OPENAI_API_KEY=

# Anthropic (future)
# PIXIS_ANTHROPIC_API_KEY=
