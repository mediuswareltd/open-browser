# OpenBrowser - AI Configuration
# Copy to .env and fill in your values

# Active AI provider: gemini | ollama | heuristic
# heuristic = no AI, uses built-in rule-based planner
OPENBROWSER_AI_PROVIDER=heuristic

# Model name (used by the active provider)
#
# Gemini free-tier models (as of March 2026):
#   gemini-2.5-flash-lite   — 15 RPM, 1000 req/day  (most generous)
#   gemini-2.5-flash        — 10 RPM,  500 req/day  (recommended)
#   gemini-2.5-pro          —  5 RPM,  100 req/day
#
# Ollama (local):
#   llama3.2, mistral, phi3, etc.
OPENBROWSER_AI_MODEL=gemini-2.5-flash

# Gemini API key (required if OPENBROWSER_AI_PROVIDER=gemini)
# Get free key at https://aistudio.google.com/app/apikey
OPENBROWSER_GEMINI_API_KEY=

# Ollama base URL (default if OPENBROWSER_AI_PROVIDER=ollama)
# Run: ollama run llama3.2
OPENBROWSER_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI (future)
# OPENBROWSER_OPENAI_API_KEY=

# Anthropic (future)
# OPENBROWSER_ANTHROPIC_API_KEY=
