{
  "root": true,
  "env": {
    "es2021": true,
    "browser": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "no-unused-vars": "off",
    "no-empty": "off"
  }
}
